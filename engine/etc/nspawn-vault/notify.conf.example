# Pushover för dead-man's switch-larm från valvet
# Kopiera till notify.conf, fyll i, chmod 600.
PUSHOVER_TOKEN=
PUSHOVER_USER=
# Slack webhook (valfritt)
SLACK_URL=

# SMTP-relä för e-postlarm (valfritt). Ett relä delas av alla källservrar -
# vilka mottagare som larmas per server styrs istället av
# /etc/nspawn-vault/<host>/notify-email (en adress per rad).
SMTP_HOST=
SMTP_PORT=587
# starttls (port 587, vanligast) eller implicit (port 465)
SMTP_TLS_MODE=starttls
SMTP_USER=
SMTP_PASS=
SMTP_FROM=nspawn-vault@example.com

# Upprepningsspärr för larm (valfri): så länge ett problem kvarstår över
# flera check-stale.sh-körningar (var 30:e minut) larmas det bara igen var
# ALERT_BACKOFF_HOURS:e timme, inte varje körning - annars blir t.ex. en
# källserver som ligger nere en hel natt en hel salva mejl/Pushover/Slack.
# Gäller både staleness/failed-larmet och ransomware-larmet nedan, var för
# sig per container. Sätt till 0 för att larma vid varje körning (gamla
# beteendet). Exit-koden/journalen påverkas inte - bara vilka larm som
# faktiskt skickas ut.
ALERT_BACKOFF_HOURS=6

# Ransomware-heuristik (valfri): pull.sh jämför varje ny snapshot mot
# föregående via "zfs diff" och räknar antalet ändrade/tillagda/borttagna
# filer. Om antalet når detta tröskelvärde flaggas containern som
# "ransomware_suspected" i sin state-JSON, och check-stale.sh larmar direkt
# (samma kanaler som ovan) oavsett om själva pullen i övrigt lyckades.
# Sätt till 0 för att stänga av kontrollen helt. Ingen global "rätt" siffra
# finns - stora/dynamiska containrar (t.ex. mycket loggskrivning) kan behöva
# ett högre värde för att undvika falsklarm.
RANSOMWARE_DIFF_THRESHOLD=500

# När tröskeln ovan nås: pull.sh sätter en "zfs hold" på senaste kända-goda
# snapshotten (så gfs-prune.sh aldrig kan radera den, oavsett GFS-retention
# eller lagringstryck) och pausar containerns kommande pullar tills någon
# bekräftat händelsen i nspawn-vault-web:s dashboard/host-vy. Detta gäller
# oavsett RANSOMWARE_GRACE_PULLS nedan.
#
# En nyskapad container fylls ofta med filer under sina första körningar
# (initial datamigrering, containern sätts upp etc.) - helt legitimt, men
# skulle annars trippa tröskeln direkt. RANSOMWARE_GRACE_PULLS hoppar över
# själva zfs-diff-kontrollen för en containers första N pullar (kontrollen
# börjar alltså från pull nr N+1). Default 3.
RANSOMWARE_GRACE_PULLS=3
